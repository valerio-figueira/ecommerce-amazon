NODE_ENV=development

# PostgreSQL (used to build DATABASE_URL when not set explicitly)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vitrine
POSTGRES_PASSWORD=vitrine
POSTGRES_DB=vitrine

# Optional override — inside Docker Compose use host "postgres"
# DATABASE_URL=postgresql://vitrine:vitrine@postgres:5432/vitrine

# Redis (used to build REDIS_URL when not set explicitly)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

# Optional override — inside Docker Compose use host "redis"
# REDIS_URL=redis://redis:6379

API_PORT=3000
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001
AMAZON_AFFILIATE_TAG=
SHOPEE_AFFILIATE_ID=
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=

# Set SEED_FORCE=true to run db:seed in production
SEED_FORCE=false
