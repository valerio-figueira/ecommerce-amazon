NODE_ENV=development

# PostgreSQL (used to build DATABASE_URL when not set explicitly)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vitrine
POSTGRES_PASSWORD=vitrine
POSTGRES_DB=vitrine

# Optional override — inside Docker Compose use host "postgres"
# DATABASE_URL=postgresql://vitrine:vitrine@postgres:5432/vitrine

# Redis (used to build REDIS_URL when not set explicitly)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
REDIS_TELEMETRY_DB=2

# Telemetry buffer (Redis staging → worker bulk flush to PostgreSQL)
TELEMETRY_BUFFER_ENABLED=true
TELEMETRY_FLUSH_BATCH_SIZE=5000
TELEMETRY_FLUSH_CRON=*/5 * * * *
TELEMETRY_BUFFER_MAX_LEN=100000

# Optional override — inside Docker Compose use host "redis"
# REDIS_URL=redis://redis:6379

API_PORT=3000
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:3000
# Optional — defaults to http://localhost:${WEB_PORT}
# WEB_PUBLIC_URL=http://localhost:3001
# Shared secret for POST /api/revalidate on apps/web (API calls after admin mutations)
REVALIDATE_SECRET=dev-revalidate-secret-change-in-production
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Brand / site metadata (packages/shared/config/brand.ts)
SITE_NAME=Vitrine
COMPANY_LEGAL_NAME=Vitrine Ltda
CONTACT_EMAIL=contato@vitrine.com.br
SITE_TAGLINE=Curadoria inteligente
# SITE_SOCIAL_INSTAGRAM=https://instagram.com/vitrine
# SITE_SOCIAL_TELEGRAM=https://t.me/vitrine_ofertas
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002
# Optional — LAN IP for Next.js dev assets (e.g. 192.168.100.6)
# NEXT_ALLOWED_DEV_ORIGINS=192.168.100.6
ADMIN_PORT=3002
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=8h
ADMIN_SEED_EMAIL=admin@vitrine.local
ADMIN_SEED_PASSWORD=vitrine-admin
PASSWORD_PEPPER=dev-pepper-change-in-production-min-16-chars

# GA4 Data API — dashboard admin (apps/api). Opcional; omitir em dev.
# GA4_PROPERTY_ID=123456789
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

AMAZON_AFFILIATE_TAG=
SHOPEE_AFFILIATE_ID=
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=

# Set SEED_FORCE=true to run db:seed in production
SEED_FORCE=false

# apps/web/.env.local
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=um_hash_aleatorio_e_seguro_aqui

GOOGLE_CLIENT_ID=seu_id_gerado_no_google_cloud.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=sua_chave_secreta_gerada_no_google

# Object storage (avatar uploads) — filesystem | s3 | gcs
STORAGE_DRIVER=filesystem
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/uploads
STORAGE_LOCAL_ROOT=./uploads

# S3 (when STORAGE_DRIVER=s3)
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GCS (when STORAGE_DRIVER=gcs)
GCS_BUCKET=
GCS_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
