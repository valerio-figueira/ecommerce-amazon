{
  "name": "@ecommerce-amazon/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cms": {
      "types": "./dist/cms/block-schemas.d.ts",
      "import": "./dist/cms/block-schemas.js"
    },
    "./seo": {
      "types": "./dist/seo/index.d.ts",
      "import": "./dist/seo/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js"
    },
    "./category/build-category-tree": {
      "types": "./dist/category/build-category-tree.d.ts",
      "import": "./dist/category/build-category-tree.js"
    },
    "./category/category-schemas": {
      "types": "./dist/category/category-schemas.d.ts",
      "import": "./dist/category/category-schemas.js"
    },
    "./category/category-tree-nav": {
      "types": "./dist/category/category-tree-nav.d.ts",
      "import": "./dist/category/category-tree-nav.js"
    },
    "./marketplace": {
      "types": "./dist/marketplace/index.d.ts",
      "import": "./dist/marketplace/index.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "import": "./dist/content/index.js"
    },
    "./product": {
      "types": "./dist/product/index.d.ts",
      "import": "./dist/product/index.js"
    },
    "./product/spec-templates": {
      "types": "./dist/product/spec-templates.d.ts",
      "import": "./dist/product/spec-templates.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@ecommerce-amazon/domain": "*",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
