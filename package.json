{
  "name": "ecommerce-amazon",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @ecommerce-amazon/domain && npm run build -w @ecommerce-amazon/shared && npm run build -w @ecommerce-amazon/application && npm run build -w @ecommerce-amazon/infrastructure && npm run build -w @ecommerce-amazon/api && npm run build -w @ecommerce-amazon/worker && npm run build -w @ecommerce-amazon/web && npm run build -w @ecommerce-amazon/admin",
    "dev:api": "turbo run dev --filter=@ecommerce-amazon/api",
    "dev:worker": "turbo run dev --filter=@ecommerce-amazon/worker",
    "dev:web": "turbo run dev --filter=@ecommerce-amazon/web",
    "dev:admin": "turbo run dev --filter=@ecommerce-amazon/admin",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "test": "node scripts/ensure-packages-built.mjs unit && vitest run",
    "test:unit": "node scripts/ensure-packages-built.mjs unit && vitest run --project unit",
    "test:integration": "node scripts/ensure-packages-built.mjs integration && vitest run --project integration",
    "db:generate": "npm run db:generate -w @ecommerce-amazon/infrastructure",
    "db:migrate": "npm run db:migrate -w @ecommerce-amazon/infrastructure",
    "db:seed": "npm run db:seed -w @ecommerce-amazon/infrastructure",
    "db:setup": "npm run db:setup -w @ecommerce-amazon/infrastructure",
    "db:init": "bash scripts/init-local-postgres.sh",
    "db:doctor": "bash scripts/db-doctor.sh",
    "infra:up": "bash scripts/compose.sh up -d postgres redis",
    "infra:down": "bash scripts/compose.sh down",
    "infra:logs": "bash scripts/compose.sh logs -f postgres redis"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.1"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20"
  }
}
