# syntax=docker/dockerfile:1
#
# Admin CMS (Next.js standalone) — produção em admin.{dominio} (sem basePath) ou /admin em fase IP.
#
FROM node:20-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
COPY packages/domain/package.json packages/domain/
COPY packages/shared/package.json packages/shared/
COPY packages/application/package.json packages/application/
COPY packages/infrastructure/package.json packages/infrastructure/

RUN npm ci

FROM deps AS build
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_URL
ARG WEB_PUBLIC_URL
ARG SITE_NAME
ARG ADMIN_BASE_PATH=
ARG ADMIN_HEALTH_PATH=/login

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV WEB_PUBLIC_URL=${WEB_PUBLIC_URL}
ENV SITE_NAME=${SITE_NAME}
ENV ADMIN_BASE_PATH=${ADMIN_BASE_PATH}

COPY tsconfig.base.json turbo.json ./
COPY packages ./packages
COPY apps ./apps

RUN find . -name 'tsconfig.tsbuildinfo' -delete && npm run build

FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV ADMIN_PORT=3002
ENV PORT=3002
ARG ADMIN_HEALTH_PATH=/login
ENV ADMIN_HEALTH_PATH=${ADMIN_HEALTH_PATH}

COPY --from=build /app/apps/admin/.next/standalone ./
COPY --from=build /app/apps/admin/.next/static ./apps/admin/.next/static

WORKDIR /app/apps/admin
EXPOSE 3002

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:3002'+(process.env.ADMIN_HEALTH_PATH||'/login'),r=>{r.resume();process.exit(r.statusCode<400?0:1)}).on('error',()=>process.exit(1))"

CMD ["node", "server.js"]
