# syntax=docker/dockerfile:1
#
# Vitrine (Next.js standalone).
# NEXT_PUBLIC_* and API URLs are baked at build time — rebuild when PUBLIC_BASE_URL changes.
#
FROM node:20-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
COPY packages/domain/package.json packages/domain/
COPY packages/shared/package.json packages/shared/
COPY packages/application/package.json packages/application/
COPY packages/infrastructure/package.json packages/infrastructure/

RUN npm ci

FROM deps AS build
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_URL
ARG WEB_PUBLIC_URL
ARG API_INTERNAL_URL
ARG SITE_NAME
ARG STORAGE_PUBLIC_BASE_URL

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV WEB_PUBLIC_URL=${WEB_PUBLIC_URL}
ENV API_INTERNAL_URL=${API_INTERNAL_URL}
ENV SITE_NAME=${SITE_NAME}
ENV STORAGE_PUBLIC_BASE_URL=${STORAGE_PUBLIC_BASE_URL}

COPY tsconfig.base.json turbo.json ./
COPY packages ./packages
COPY apps ./apps

RUN find . -name 'tsconfig.tsbuildinfo' -delete && npm run build

FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV WEB_PORT=3001
ENV PORT=3001

# Standalone output mirrors the monorepo directory layout under apps/web.
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static

WORKDIR /app/apps/web
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:3001/',r=>{r.resume();process.exit(r.statusCode<400?0:1)}).on('error',()=>process.exit(1))"

CMD ["node", "server.js"]
